# For local development: run `npx vercel link` then `npx vercel env pull`
# to generate a real .env.local from your linked Vercel project — these are
# normally set automatically by the Neon and Upstash integrations (Vercel
# dashboard -> Storage tab), not by hand. See README "Deployment".

# Postgres connection string (Neon integration sets this).
DATABASE_URL=postgres://user:password@host/eventx

# Upstash Redis REST credentials (Upstash integration sets these — either
# naming works, see api/_lib/redis.js). Read automatically by Redis.fromEnv().
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# or, if you added Redis via the Vercel "KV" product naming:
# KV_REST_API_URL=https://example.upstash.io
# KV_REST_API_TOKEN=your-token

# Session signing secret for auth (api/_lib/auth.js). Not provided by any
# integration — generate your own: `openssl rand -base64 32`.
JWT_SECRET=replace-with-a-real-random-secret

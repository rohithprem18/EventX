# Copy to .env and fill in. See README "Deployment" for where each value
# comes from (Neon for DATABASE_URL, Upstash for REDIS_URL).

# ── Backend (server/index.js) ──────────────────────────────────────────
# Postgres connection string. Source of truth for bookings — this is what
# makes double-booking impossible, see server/db.js.
DATABASE_URL=postgres://user:password@host:5432/eventx

# Redis connection string. Backs the self-expiring seat locks and the
# cross-instance pub/sub fan-out, see server/redis.js. Use rediss:// (TLS)
# for a hosted Redis like Upstash.
REDIS_URL=rediss://default:password@host:6379

# Port the booking API listens on. Render sets this automatically in
# production — only needed locally, and only if you want something other
# than 3001.
# PORT=3001

# Comma-separated list of origins allowed to call the API, or `*` for any
# (fine for a public demo; tighten this once you have a real frontend URL).
# CORS_ORIGIN=https://your-frontend.vercel.app

# ── Frontend (Vite) ─────────────────────────────────────────────────────
# Where the built frontend should send booking API requests. Leave unset
# for local dev (defaults to http://localhost:3001); set to the deployed
# backend's URL before building for production.
# VITE_API_URL=https://your-backend.onrender.com
